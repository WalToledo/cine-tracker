# Copiar a `.env.test` para que `npm run test:backend` no escriba en la base de
# desarrollo. Sólo hace falta redefinir lo que cambia: el resto se hereda del `.env`.
#
# Preparar la base una vez:
#   CREATE DATABASE cinetracker_test;
#   npx prisma migrate deploy   (desde backend/, con DATABASE_URL apuntando a ella)

DATABASE_URL="mysql://user:password@localhost:3306/cinetracker_test"
JWT_SECRET="test-secret"
