DATABASE_URL="mysql://user:password@localhost:3306/cinetracker"
JWT_SECRET="replace-with-a-strong-secret"
PORT=4000

# Origen exacto del frontend. Es el único que CORS deja pasar con credenciales, y
# sin credenciales el navegador no manda la cookie de sesión. Opcional: por defecto
# es http://localhost:5173 (el puerto de Vite).
FRONTEND_URL="http://localhost:5173"

# API Key v3 de TMDB (https://www.themoviedb.org/settings/api). Vive sólo en el
# servidor: el frontend consume las películas por el proxy /api/movies y nunca
# ve la clave. Si se deja vacía, el backend responde con datos mockeados.
TMDB_API_KEY=""

# Las variables del frontend NO van aquí: Vite no lee este archivo (no hay `envDir`
# configurado). Ver frontend/.env.example.
